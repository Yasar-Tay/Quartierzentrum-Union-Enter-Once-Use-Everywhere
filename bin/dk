#!/usr/bin/env bash
# Run a command inside a container with the project mounted at /app.
# Usage: bin/dk <command> [args...]   Image: $EO_IMAGE (default php:8.1-cli)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && (pwd -W 2>/dev/null || pwd))"
MSYS_NO_PATHCONV=1 exec docker run --rm -v "$ROOT":/app -w /app "${EO_IMAGE:-php:8.1-cli}" "$@"
