{
    "name": "enteronce/enter-once-sync",
    "description": "Enter once, show everywhere: syncs a neighbourhood centre's public calendar (ICS) to an association website and a public feed.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "sabre/vobject": "^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "EnterOnce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnterOnce\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
