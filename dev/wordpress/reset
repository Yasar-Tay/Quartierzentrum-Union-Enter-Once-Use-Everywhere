#!/usr/bin/env bash
# Deletes the local test site (database and WordPress files) and starts it fresh.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && (pwd -W 2>/dev/null || pwd))"
MSYS_NO_PATHCONV=1 docker compose -f "$ROOT/docker-compose.yml" down -v --remove-orphans
exec "$ROOT/dev/wordpress/start"
